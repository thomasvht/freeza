{
  "name": "freeza",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently \"wrangler dev\" \"ng serve\"",
    "db:migrate:local": "wrangler d1 migrations apply freeza-db --local",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && vitest run -c vitest.worker.config.mts",
    "test:worker": "vitest run -c vitest.worker.config.mts",
    "e2e": "playwright test",
    "deploy": "wrangler d1 migrations apply freeza-db --remote && wrangler deploy"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/service-worker": "^21.2.26",
    "@fontsource/manrope": "^5.3.0",
    "@lucide/angular": "^1.69.0",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.6",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.158.0"
  }
}
