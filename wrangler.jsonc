{
	"name": "freeza",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"routes": [
		{
			"pattern": "freeza.ki-tho.be",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist/freeza/browser",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "freeza-db",
			"database_id": "72fd9c88-0f34-4926-be2a-45e2fb74113c",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	// Keep ALLOWED_EMAILS, which is set in the Cloudflare dashboard.
	"keep_vars": true,
	"vars": {
		"ENVIRONMENT": "production",
		"ACCESS_TEAM_DOMAIN": "freeza-ki-tho.cloudflareaccess.com",
		"ACCESS_AUD": "7fdfa014f7a477786ae5640a4013b2fb27010a7ebc9ede714fdeb6e267ae074b"
	}
}